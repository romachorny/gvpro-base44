// A visitor who pressed one of the two doors under the preview.
// Anonymous visitors may create one and nothing else; only the studio (role admin) reads and edits.
// The permissions live in the Base44 app settings, not in this file — the intended rules are
// written out in MANIFEST.md and Cowork applies them.
{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "What the visitor calls themselves"
    },
    "business_name": {
      "type": "string",
      "description": "The name typed into GVPro, the one on the preview"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp number in international form, digits only, e.g. 972501234567"
    },
    "note": {
      "type": "string",
      "description": "Anything the visitor wanted to add. Optional."
    },
    "niche": {
      "type": "string",
      "description": "The trade on screen when the button was pressed",
      "enum": ["barber", "clinic", "bakery", "yoga", "garage"]
    },
    "style": {
      "type": "string",
      "description": "The template on screen when the button was pressed",
      "enum": ["fade", "pole", "salon", "grid", "neon", "poster", "zine", "mag", "kiosk", "bands", "mono", "gold"]
    },
    "lang": {
      "type": "string",
      "description": "The language the app was in",
      "enum": ["en", "he", "ru", "ar"]
    },
    "want": {
      "type": "string",
      "description": "Which of the two doors: the site, or the app with booking and orders",
      "enum": ["site", "app"]
    },
    "status": {
      "type": "string",
      "description": "Where the lead stands. Only the studio changes it.",
      "enum": ["new", "contacted", "won", "lost"],
      "default": "new"
    },
    "source": {
      "type": "string",
      "description": "Which product sent it",
      "default": "gvpro"
    }
  },
  "required": ["name", "business_name", "whatsapp", "want"]
}
