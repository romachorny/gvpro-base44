// A visitor who pressed "I want this app".
// Anonymous visitors may create one and nothing else; only the studio (role admin) reads and
// edits. The permissions live in the Base44 app settings, not in this file — the intended rules
// are written out in MANIFEST.md and Cowork applies them.
{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "What the visitor calls themselves"
    },
    "business_name": {
      "type": "string",
      "description": "The name typed into GVPro, the one on the demo app"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp number in international form, digits only, e.g. 972501234567"
    },
    "note": {
      "type": "string",
      "description": "Anything the visitor wanted to add. Optional."
    },
    "job": {
      "type": "string",
      "description": "What the business said it needs the app for",
      "enum": ["booking", "orders", "menu", "catalogue", "team"]
    },
    "colour": {
      "type": "string",
      "description": "The accent they chose for their app",
      "enum": ["blue", "teal", "green", "violet", "amber", "rose"]
    },
    "package": {
      "type": "string",
      "description": "Which of the three they picked",
      "enum": ["start", "business", "pro"]
    },
    "lang": {
      "type": "string",
      "description": "The language the app was in",
      "enum": ["he", "en", "ru", "ar"]
    },
    "status": {
      "type": "string",
      "description": "Where the lead stands. Only the studio changes it.",
      "enum": ["new", "contacted", "won", "lost"],
      "default": "new"
    },
    "source": {
      "type": "string",
      "description": "Which product sent it",
      "default": "gvpro"
    }
  },
  "required": ["name", "business_name", "whatsapp", "job"]
}
